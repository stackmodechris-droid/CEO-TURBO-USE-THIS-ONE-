{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/audit.js": {
      "maxDuration": 40
    },
    "api/lead.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/website",
      "destination": "/services/website-design",
      "permanent": true
    },
    {
      "source": "/brand-strategy-call",
      "destination": "/brand-boost",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/brand-boost",
      "permanent": true
    },
    {
      "source": "/get-more-clients",
      "destination": "/local-business",
      "permanent": true
    },
    {
      "source": "/scale-personal-brand",
      "destination": "/services/social-media-optimization",
      "permanent": true
    },
    {
      "source": "/brand-ecosystem",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/artists",
      "destination": "/artist",
      "permanent": true
    },
    {
      "source": "/local",
      "destination": "/local-business",
      "permanent": true
    },
    {
      "source": "/digital-business-card",
      "destination": "/google-review-cards",
      "permanent": true
    },
    {
      "source": "/card",
      "destination": "/google-review-cards",
      "permanent": true
    },
    {
      "source": "/nfc-card",
      "destination": "/google-review-cards",
      "permanent": true
    },
    {
      "source": "/review-cards",
      "destination": "/google-review-cards",
      "permanent": true
    },
    {
      "source": "/review-card",
      "destination": "/google-review-cards",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/google-review-cards",
      "permanent": false
    },
    {
      "source": "/setup",
      "destination": "/google-review-card-setup",
      "permanent": false
    },
    {
      "source": "/audit",
      "destination": "/free-audit",
      "permanent": false
    },
    {
      "source": "/nfc-business-card",
      "destination": "/how-to-get-more-google-reviews",
      "permanent": true
    },
    {
      "source": "/guides/nfc-business-card",
      "destination": "/how-to-get-more-google-reviews",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://app.cal.com https://cal.com https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self'; frame-src https://app.cal.com https://cal.com https://*.cal.com https://www.facebook.com; connect-src 'self' https://app.cal.com https://cal.com https://*.cal.com https://www.google-analytics.com https://*.google-analytics.com https://www.facebook.com; form-action 'self' https://cal.com https://app.cal.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
