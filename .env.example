# Copy to .env.local for local testing, and add the same keys in Vercel → Settings → Environment Variables.
# Full checklist: docs/tracking-setup.md

# Leads → Google Sheet (docs/leads-google-sheet.md)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Meta: the Pixel id is built in (3232222473609236); set this only to override it.
VITE_META_PIXEL_ID=
# Server-side Pixel id override (defaults to the built-in id) and Graph API version.
META_PIXEL_ID=
META_GRAPH_VERSION=
# Meta Conversions API (server-side Lead + Schedule). Events Manager → pixel → Settings → Generate access token.
META_CAPI_TOKEN=
# Optional: paste the "Test events" code while testing, then delete it.
META_TEST_EVENT_CODE=

# Shopify order webhook signing secret (Shopify admin → Settings → Notifications → Webhooks). Paid card orders → Google Sheet.
SHOPIFY_WEBHOOK_SECRET=

# Microsoft Advertising UET tag id (Microsoft Ads → Tools → UET tag).
VITE_UET_TAG_ID=

# TikTok (when you start TikTok ads): Pixel id for the browser, access token for the server-side Events API.
VITE_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
# Optional while testing (TikTok Events Manager → Test events), then delete.
TIKTOK_TEST_EVENT_CODE=

# Cal.com webhook signing secret (Cal.com → Settings → Developer → Webhooks).
CAL_WEBHOOK_SECRET=

# Optional: free Google PageSpeed Insights key for real mobile speed scores in the audit
PSI_API_KEY=
