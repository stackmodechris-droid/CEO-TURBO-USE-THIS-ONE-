# Copy to .env.local for local testing, and add the same keys in Vercel → Settings → Environment Variables.
# See docs/leads-google-sheet.md.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
# Optional: free Google PageSpeed Insights key for real mobile speed scores in the audit
PSI_API_KEY=
# Meta Pixel ID (Events Manager → Data sources). Needed to run Meta ads that optimize for booked calls.
VITE_META_PIXEL_ID=
